# Salin file ini jadi .env lalu isi sesuai kebutuhan.

# ===== TELEGRAM =====
# Token dari @BotFather (contoh: 123456789:ABCdef...). Kosongkan kalau tidak pakai Telegram.
TELEGRAM_TOKEN=
# ID akun Telegram kamu (kirim pesan apa saja ke bot, nanti bot memberitahu ID-mu)
TELEGRAM_OWNER_ID=

# ===== WHATSAPP =====
# Isi false untuk mematikan WhatsApp (hanya pakai Telegram)
WA_AKTIF=true

# Notifikasi otomatis dikirim ke: telegram | wa | semua
# (kosong = Telegram kalau sudah diatur, selain itu WA)
NOTIF_KE=

# Nomor WhatsApp kamu (format internasional, tanpa + atau spasi), contoh: 6281234567890
# - Kalau bot jalan di NOMOR LAIN (nomor kedua), isi dengan nomor pribadimu supaya
#   hanya kamu yang dilayani bot.
# - Kalau bot jalan di nomormu sendiri, kosongkan saja lalu chat lewat "Message yourself"
#   (chat ke diri sendiri) di WhatsApp.
OWNER_NUMBER=

# Zona waktu untuk menghitung "minggu ini", "hari ini", dll.
TZ_NAME=Asia/Jakarta

# Jadwal pengingat otomatis (format cron). Default: tiap hari jam 07:00.
# Kosongkan untuk mematikan pengingat otomatis.
REMINDER_CRON=0 7 * * *

# Seberapa sering cek tugas baru & deadline 3 jam (menit, minimal 5)
CEK_CLASSROOM_MENIT=15

# Pengingat kuliah berapa menit sebelum mulai
MENIT_SEBELUM_KULIAH=30

# Jadwal backup data bot ke WhatsApp (format cron). Default tiap hari jam 23:00. Kosongkan untuk mematikan.
BACKUP_CRON=0 23 * * *

# Folder penyimpanan file kiriman WA. Default: /sdcard/BotTugas di HP, data/files di laptop.
# FILES_DIR=
